			</dependency>
			<dependency>
				<groupId>io.github.morgoth398</groupId>
				<artifactId>VolucrisBindings-GLFW</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>io.github.morgoth398</groupId>
